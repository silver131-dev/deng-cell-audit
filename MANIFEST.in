include README.md README.zh-TW.md RELEASE_NOTES.md LICENSE_DECISION.md
include LICENSE DATA_AND_THIRD_PARTY_RIGHTS.md
include requirements-tested.txt release-files.txt release_manifest.json
include .gitattributes .gitignore
recursive-include .github *.yml
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
global-exclude *.pyc
global-exclude *.h5ad
global-exclude *.npz
global-exclude *.xlsx
prune results
prune private
prune data

